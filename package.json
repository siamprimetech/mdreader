{
  "name": "md-reader",
  "private": true,
  "version": "1.0.0",
  "description": "A cross-platform markdown reader built with Tauri v2",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check": "npm run typecheck && npm run test && npm run build",
    "dev": "vite",
    "icons": "bash tools/make-icons.sh",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build --no-sign",
    "tauri:dev": "tauri dev",
    "tauri:release": "tauri build",
    "test": "node --test 'tests/*.test.ts'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
